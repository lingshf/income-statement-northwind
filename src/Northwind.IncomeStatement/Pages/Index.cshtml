@page
@model IndexModel
@using System.Globalization
@using Northwind.IncomeStatement.Domain
@{
    ViewData["Title"] = "Income statement";
    var report = Model.Report;
    static string Iso(DateOnly d) => d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    static string Long(DateOnly d) => d.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
}

<div class="controls">
    <h1>Income statement</h1>
    <form method="get" class="period-form">
        <label for="start">Start date</label>
        <input id="start" name="start" type="date" value="@Model.Start" />
        <label for="end">End date</label>
        <input id="end" name="end" type="date" value="@Model.End" />
        <button type="submit">Show statement</button>
    </form>
</div>

@if (Model.Errors.Count > 0)
{
    <div class="message error" role="alert">
        <p><strong>The statement could not be produced because the period is invalid:</strong></p>
        <ul>
            @foreach (var error in Model.Errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@if (report is not null)
{
    <section class="statement" aria-labelledby="statement-heading">
        <header class="statement-header">
            <h2 id="statement-heading">@report.Company</h2>
            <p class="statement-title">Income Statement</p>
            <p class="period">
                For the period
                <time datetime="@Iso(report.Start)">@Long(report.Start)</time>
                &ndash;
                <time datetime="@Iso(report.End)">@Long(report.End)</time>
                (both inclusive)
            </p>
            <p class="currency">(<span>@report.Currency</span>)</p>
        </header>

        @if (!report.HasActivity)
        {
            <p class="message info" role="status">No posted activity in this period. All amounts are zero.</p>
        }

        <table>
            <thead class="visually-hidden">
                <tr>
                    <th scope="col">Line item</th>
                    <th scope="col">Amount (@report.Currency)</th>
                </tr>
            </thead>
            @await Html.PartialAsync("_StatementSection", (report.Revenue, "Net revenue"))
            @await Html.PartialAsync("_StatementSection", (report.CostOfGoodsSold, "Total cost of goods sold"))
            <tbody class="result">
                <tr class="profit">
                    <th scope="row">Gross profit</th>
                    <td class="amount">@report.GrossProfit.ToAccountingString()</td>
                </tr>
            </tbody>
            @await Html.PartialAsync("_StatementSection", (report.OperatingExpenses, "Total operating expenses"))
            <tbody class="result">
                <tr class="profit">
                    <th scope="row">Operating income</th>
                    <td class="amount">@report.OperatingIncome.ToAccountingString()</td>
                </tr>
            </tbody>
            @await Html.PartialAsync("_StatementSection", (report.OtherIncome, "Total other income"))
            <tbody class="result">
                <tr class="net-income @(report.NetIncome < Money.Zero ? "loss" : "")">
                    <th scope="row">Net income</th>
                    <td class="amount">@report.NetIncome.ToAccountingString()</td>
                </tr>
            </tbody>
        </table>
        <p class="note">Negative amounts are shown in parentheses. Only posted journal entries are included.</p>
    </section>
}
