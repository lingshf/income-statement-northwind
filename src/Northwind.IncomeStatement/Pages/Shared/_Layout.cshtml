<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Northwind Income Statement</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main class="@ViewData["MainClass"]">
        <nav class="site-nav" aria-label="Reports">
            <a asp-page="/Index">Income statement</a>
            <a asp-page="/Reconciliation">Bank reconciliation</a>
        </nav>
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
